{
  "openapi": "3.1.0",
  "info": {
    "title": "LunarEdge API",
    "description": "Lunar Landing Site Navigator backend. Scientific adapters are stubs until Member 4 implements Horizons/LOLA.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sites": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Sites",
        "operationId": "sites_api_v1_sites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LandingSite"
                  },
                  "type": "array",
                  "title": "Response Sites Api V1 Sites Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sites/{site_id}": {
      "get": {
        "tags": [
          "sites"
        ],
        "summary": "Site Detail",
        "operationId": "site_detail_api_v1_sites__site_id__get",
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Site Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandingSite"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analysis": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Create Analysis",
        "operationId": "create_analysis_api_v1_analysis_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analysis/{analysis_id}": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Get Analysis",
        "operationId": "get_analysis_api_v1_analysis__analysis_id__get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/analysis/{analysis_id}/export.csv": {
      "get": {
        "tags": [
          "analysis"
        ],
        "summary": "Export Analysis",
        "operationId": "export_analysis_api_v1_analysis__analysis_id__export_csv_get",
        "parameters": [
          {
            "name": "analysis_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Analysis Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/compare": {
      "post": {
        "tags": [
          "compare"
        ],
        "summary": "Compare",
        "operationId": "compare_api_v1_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompareRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlignedMetric": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "values": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Values"
          }
        },
        "type": "object",
        "required": [
          "key",
          "unit",
          "values"
        ],
        "title": "AlignedMetric"
      },
      "AnalysisOptions": {
        "properties": {
          "include_terrain": {
            "type": "boolean",
            "title": "Include Terrain",
            "default": false
          },
          "earth_visibility_mode": {
            "type": "string",
            "const": "center",
            "title": "Earth Visibility Mode",
            "default": "center"
          },
          "solar_array_tilt_deg": {
            "type": "number",
            "title": "Solar Array Tilt Deg",
            "default": 0
          },
          "custom_observer": {
            "type": "boolean",
            "title": "Custom Observer",
            "default": false
          }
        },
        "type": "object",
        "title": "AnalysisOptions"
      },
      "AnalysisRequest": {
        "properties": {
          "site_id": {
            "type": "string",
            "title": "Site Id"
          },
          "observer": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Observer"
              },
              {
                "type": "null"
              }
            ]
          },
          "time": {
            "$ref": "#/components/schemas/TimeWindow"
          },
          "options": {
            "$ref": "#/components/schemas/AnalysisOptions"
          }
        },
        "type": "object",
        "required": [
          "site_id",
          "time"
        ],
        "title": "AnalysisRequest"
      },
      "AnalysisResponse": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "not_implemented",
              "error"
            ],
            "title": "Status"
          },
          "site": {
            "$ref": "#/components/schemas/SiteRef"
          },
          "time": {
            "$ref": "#/components/schemas/TimeSpan"
          },
          "quality": {
            "$ref": "#/components/schemas/Quality"
          },
          "summary": {
            "$ref": "#/components/schemas/AnalysisSummary"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/Sample"
            },
            "type": "array",
            "title": "Samples"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "status",
          "site",
          "time",
          "quality",
          "summary",
          "provenance"
        ],
        "title": "AnalysisResponse"
      },
      "AnalysisSummary": {
        "properties": {
          "sunlight_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sunlight Hours"
          },
          "earth_visibility_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earth Visibility Hours"
          },
          "longest_earth_blackout_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longest Earth Blackout Hours"
          },
          "mean_solar_elevation_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Solar Elevation Deg"
          },
          "relative_solar_incidence_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relative Solar Incidence Mean"
          },
          "terrain_slope_mean_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terrain Slope Mean Deg"
          }
        },
        "type": "object",
        "title": "AnalysisSummary"
      },
      "BodySample": {
        "properties": {
          "azimuth_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Azimuth Deg"
          },
          "elevation_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Elevation Deg"
          },
          "geometric_visible": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geometric Visible"
          },
          "terrain_visible": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Terrain Visible"
          },
          "relative_incidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Relative Incidence"
          },
          "visibility_fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visibility Fraction"
          }
        },
        "type": "object",
        "title": "BodySample"
      },
      "CompareRequest": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioInput"
            },
            "type": "array",
            "title": "Scenarios"
          }
        },
        "type": "object",
        "required": [
          "scenarios"
        ],
        "title": "CompareRequest"
      },
      "CompareResponse": {
        "properties": {
          "comparison_id": {
            "type": "string",
            "title": "Comparison Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/ScenarioResult"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "aligned_metrics": {
            "items": {
              "$ref": "#/components/schemas/AlignedMetric"
            },
            "type": "array",
            "title": "Aligned Metrics"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "comparison_id",
          "status",
          "scenarios",
          "aligned_metrics"
        ],
        "title": "CompareResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "lunaredge-api"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "supabase_configured": {
            "type": "boolean",
            "title": "Supabase Configured"
          },
          "sites_source": {
            "type": "string",
            "title": "Sites Source",
            "description": "supabase when landing_sites rows load; otherwise json_fallback"
          },
          "horizons_adapter": {
            "type": "string",
            "title": "Horizons Adapter",
            "description": "implemented | stub \u2014 Member 4 owns the Horizons client"
          },
          "demo_analysis_enabled": {
            "type": "boolean",
            "title": "Demo Analysis Enabled"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment",
          "supabase_configured",
          "sites_source",
          "horizons_adapter",
          "demo_analysis_enabled"
        ],
        "title": "HealthResponse"
      },
      "LandingSite": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Public site_id / slug"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "gsfc_site_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gsfc Site Id"
          },
          "latitude_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude Deg"
          },
          "longitude_east_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude East Deg"
          },
          "altitude_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude Km"
          },
          "coordinate_reference": {
            "type": "string",
            "title": "Coordinate Reference"
          },
          "verification_status": {
            "type": "string",
            "title": "Verification Status"
          },
          "terrain_status": {
            "type": "string",
            "title": "Terrain Status"
          },
          "dem_product_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dem Product Id"
          },
          "dem_resolution_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dem Resolution M"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "data_page_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data Page Url"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "coordinate_reference",
          "verification_status",
          "terrain_status"
        ],
        "title": "LandingSite",
        "description": "Curated catalogue row. Null coordinates mean unverified, not zero."
      },
      "Observer": {
        "properties": {
          "latitude_deg": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 90.0,
                "minimum": -90.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude Deg"
          },
          "longitude_east_deg": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 360.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude East Deg"
          },
          "altitude_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Altitude Km"
          },
          "coordinate_reference": {
            "type": "string",
            "title": "Coordinate Reference",
            "default": "MOON_ME_PENDING_VERIFICATION"
          }
        },
        "type": "object",
        "title": "Observer"
      },
      "Provenance": {
        "properties": {
          "sun_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sun Source"
          },
          "earth_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Earth Source"
          },
          "dem_product": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dem Product"
          },
          "retrieved_at_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved At Utc"
          },
          "calculation_version": {
            "type": "string",
            "title": "Calculation Version",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "Provenance"
      },
      "Quality": {
        "properties": {
          "ephemeris": {
            "type": "string",
            "enum": [
              "jpl_horizons",
              "unavailable",
              "demo_mock"
            ],
            "title": "Ephemeris"
          },
          "terrain": {
            "type": "string",
            "enum": [
              "geometric_only",
              "terrain_aware",
              "unavailable"
            ],
            "title": "Terrain"
          },
          "earth_visibility": {
            "type": "string",
            "enum": [
              "earth_center",
              "unavailable"
            ],
            "title": "Earth Visibility"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "ephemeris",
          "terrain",
          "earth_visibility"
        ],
        "title": "Quality"
      },
      "Sample": {
        "properties": {
          "time_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Time Utc"
          },
          "sun": {
            "$ref": "#/components/schemas/BodySample"
          },
          "earth": {
            "$ref": "#/components/schemas/BodySample"
          }
        },
        "type": "object",
        "required": [
          "time_utc",
          "sun",
          "earth"
        ],
        "title": "Sample"
      },
      "ScenarioInput": {
        "properties": {
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "request": {
            "$ref": "#/components/schemas/AnalysisRequest"
          }
        },
        "type": "object",
        "required": [
          "request"
        ],
        "title": "ScenarioInput"
      },
      "ScenarioResult": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnalysisResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "index"
        ],
        "title": "ScenarioResult"
      },
      "SiteRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latitude_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude Deg"
          },
          "longitude_east_deg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude East Deg"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "SiteRef"
      },
      "TimeSpan": {
        "properties": {
          "start_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Start Utc"
          },
          "end_utc": {
            "type": "string",
            "format": "date-time",
            "title": "End Utc"
          },
          "step_minutes": {
            "type": "integer",
            "title": "Step Minutes"
          },
          "sample_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Count"
          }
        },
        "type": "object",
        "required": [
          "start_utc",
          "end_utc",
          "step_minutes"
        ],
