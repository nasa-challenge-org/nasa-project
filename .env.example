# Copy values into frontend/.env.local and backend/.env as needed.
# This is the shared template. Do not commit filled .env files.
# Never commit real .env files or the Supabase service-role key.

# --- Frontend (browser-safe only) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set true only in local UI development. Demo values must stay labelled DEMO / MOCK.
NEXT_PUBLIC_ALLOW_DEMO_FIXTURE=true

# --- Backend (server only) ---
APP_ENV=development
APP_VERSION=0.1.0
CORS_ORIGINS=http://localhost:3000
ENABLE_DEMO_ANALYSIS=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URI — backend only. Never put this in NEXT_PUBLIC_*.
SUPABASE_DATABASE_URL=
HORIZONS_BASE_URL=https://ssd.jpl.nasa.gov/api/horizons.api
DATA_DIR=./data
EPHEMERIS_CACHE_TTL_SECONDS=86400

# Never put SUPABASE_SERVICE_ROLE_KEY or private secrets in NEXT_PUBLIC_* variables.
